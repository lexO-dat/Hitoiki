    "@capacitor/preferences": "7.0.4",
    "@capacitor/share": "7.0.4",
    "@capgo/capacitor-updater": "7.51.23",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
