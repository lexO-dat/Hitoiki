{
  "name": "hitoiki",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "validate-levels": "node scripts/validate_levels.mjs",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:e2e": "vite build && node --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "test:tz": "for tz in America/Santiago Europe/Madrid Asia/Tokyo Pacific/Kiritimati; do echo \"TZ=$tz\"; TZ=$tz node --test tests/*.test.js || exit 1; done"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/share": "7.0.4",
    "@capgo/capacitor-updater": "7.51.23",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.2",
    "playwright": "^1.64.1",
    "vite": "^6.4.5"
  }
}
